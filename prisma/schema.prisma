generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CreditTxType {
  AWARD
  ADJUSTMENT
}

enum Role {
  USER
  ADMIN
}

enum CreditTxReason {
  TRAINING_CLAIM
  ADMIN_ADJUST
  CERTIFICATE_ISSUED
  FEEDBACK_SUBMITTED
}

enum FeedbackFormType {
  PUBLIC
  INHOUSE
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
  COMPLETED
  CERTIFICATE_ISSUED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum CertificateKind {
  ATTENDANCE_CONFIRMATION
  CERTIFICATE
  VDI_CERTIFICATE
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

/// Bestätigung der E-Mail-Adresse für ein bereits bestehendes Konto.
///
/// Wird für Neuregistrierungen nicht mehr benutzt (dafür OffeneRegistrierung),
/// bleibt aber für Konten aus der Übergangszeit bestehen.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

/// Angefangene Registrierung, die noch nicht bestätigt wurde.
///
/// Das Konto entsteht erst beim Anklicken des Bestätigungslinks — vorher gibt
/// es nur diesen Datensatz. Der Grund: Legte die Registrierung sofort ein Konto
/// an, konnte jemand eines auf eine fremde Adresse eröffnen; der echte
/// Adressinhaber schaltete es beim Bestätigen frei, und das hinterlegte
/// Passwort war das des anderen.
///
/// So trägt der Link genau die Daten dessen, der ihn angefordert hat. Eine
/// neue Anforderung für dieselbe Adresse löscht die vorherige.
model OffeneRegistrierung {
  id           String   @id @default(cuid())
  token        String   @unique
  email        String
  passwordHash String
  name         String
  firstName    String?
  lastName     String?
  birthDate    DateTime
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([token])
  @@index([email])
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  name      String?
  firstName String?
  lastName  String?
  birthDate DateTime?
  gender    String?
  phone     String?

  company        String?
  companyAddress String?
  companyStreet  String?
  companyZip     String?
  companyCity    String?
  companyCountry String?
  position       String?

  role         Role @default(USER)
  isInstructor Boolean @default(false)
  creditsTotal Int  @default(0)

  leaderboardOptIn Boolean @default(false)
  leaderboardName  String?

  notifyBeforeTraining Boolean @default(true)

  /// Gesetzt, sobald die Adresse über den Bestätigungslink belegt wurde.
  /// Bestandskonten gelten als bestätigt (siehe Migration), damit niemand
  /// ausgesperrt wird.
  emailVerifiedAt DateTime?

  lastLoginAt DateTime?

  creditTxs          CreditTransaction[]
  enrollments        Enrollment[]
  certificates       Certificate[]
  trainingFeedbacks  TrainingFeedback[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  documents          UserDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Training {
  id    String @id @default(cuid())
  title String

  code String?

  date DateTime

  endDate     DateTime?
  location    String?
  instructor  String?
  description String?

  certificateKind CertificateKind?

  cobraId String? @unique

  creditsAward Int @default(0)

  tokens            ClaimToken[]
  creditTxs         CreditTransaction[]
  enrollments       Enrollment[]
  certificates      Certificate[]
  feedbacks         TrainingFeedback[]
  cobraParticipants CobraTrainingParticipant[]
  orgaMails         KursOrgaMail[]
  signedLists       SignedParticipantList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([certificateKind])
}

model Enrollment {
  id         String @id @default(cuid())
  userId     String
  trainingId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  status   EnrollmentStatus @default(CONFIRMED)
  attended Boolean          @default(false)
  passed   Boolean          @default(false)

  certificate Certificate?
  feedback    TrainingFeedback?

  registeredAt DateTime @default(now())
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, trainingId])
  @@index([trainingId, status])
  @@index([userId, status])
}

model Certificate {
  id           String @id @default(cuid())
  userId       String
  trainingId   String
  enrollmentId String @unique

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  training   Training   @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  title    String
  issuedAt DateTime          @default(now())
  status   CertificateStatus @default(ISSUED)
  credits  Int               @default(0)

  code            String?
  certificateKind CertificateKind?

  pdfUrl String?
  note   String?

  creditTx CreditTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, issuedAt])
  @@index([trainingId, issuedAt])
  @@index([code])
  @@index([certificateKind])
}

model ClaimToken {
  id         String   @id @default(cuid())
  token      String   @unique
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  maxClaims Int @default(999999)
  claims    Int @default(0)

  creditTxs CreditTransaction[]

  createdAt DateTime @default(now())
}

model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  amount Int
  type   CreditTxType
  reason CreditTxReason

  trainingId    String?
  certificateId String? @unique
  claimTokenId  String?
  feedbackId    String? @unique

  meta Json?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  training    Training?         @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  certificate Certificate?      @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  claimToken  ClaimToken?       @relation(fields: [claimTokenId], references: [id], onDelete: SetNull)
  feedback    TrainingFeedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([trainingId, createdAt])
  @@index([claimTokenId, createdAt])
  @@index([certificateId, createdAt])
}

model TrainingFeedback {
  id           String @id @default(cuid())
  userId       String
  trainingId   String
  enrollmentId String @unique

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  training   Training   @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  formType       FeedbackFormType
  anonymous      Boolean          @default(false)
  overallRating  Int?
  answers        Json
  creditsAwarded Int              @default(0)

  creditTx CreditTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingId, createdAt])
  @@index([userId])
}

// Selbst hochgeladene Nachweise (externe Weiterbildungen, Abschlüsse etc.).
// Dateien liegen in Vercel Blob; hier nur Metadaten + URL.
model UserDocument {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  category   String?
  issuer     String?
  issuedDate DateTime?

  fileUrl      String
  filePathname String
  fileType     String
  fileSize     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model CobraTrainingParticipant {
  id String @id @default(cuid())

  cobraParticipantId String @unique

  cobraTrainingCaption String?
  cobraTrainingId      String?

  trainingId String?
  training   Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)

  caption         String?
  participantText String
  participantType String?
  status          String?

  email     String?
  firstName String?
  lastName  String?
  company   String?

  // Anwesenheit, vom Dozenten gepflegt (ANWESEND | NICHT_DA | KRANK | null = offen).
  attendanceStatus String?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cobraTrainingId])
  @@index([trainingId])
  @@index([email])
  @@index([participantType])
  @@index([status])
}

/// Organisations-/Orga-Mail zu einer Schulung (Hotel, Anreise, Ansprechpartner …).
/// Kommt per CC an die Resend-Inbound-Adresse rein und wird im Dozentenbereich
/// (Tab „Infos") angezeigt. Zuordnung zum Kurs über den Kurscode im Betreff.
model KursOrgaMail {
  id String @id @default(cuid())

  /// Resend `email.received` email_id – sorgt für Idempotenz bei Webhook-Retries.
  resendEmailId String @unique

  /// Aus dem Betreff gematchter Kurscode (UPPERCASE, == Wix kurscode == Training.code).
  kurscode String

  /// Optionaler Link zum DB-Training, falls per Code gefunden.
  trainingId String?
  training   Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)

  subject     String?
  fromAddress String?

  text String? @db.Text
  html String? @db.Text // gespeichert, aber nicht roh gerendert

  /// [{ url, pathname, filename, contentType, size }] – Bilder liegen in Vercel Blob.
  attachments Json?

  receivedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kurscode])
  @@index([trainingId])
}

/// Vom Dozenten vor Ort abfotografierte, unterschriebene Teilnehmerliste.
/// Mehrere Fotos werden zu einem PDF (in Vercel Blob) zusammengefasst und der
/// Schulung über den Kurscode zugeordnet. Sichtbar für den Dozenten (eigene
/// Uploads) und im Admin-Bereich.
model SignedParticipantList {
  id String @id @default(cuid())

  /// Kurscode UPPERCASE (== Wix kurscode == Training.code).
  kurscode String

  /// Optionaler Link zum DB-Training, per Code aufgelöst.
  trainingId String?
  training   Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)

  /// Hochladender Dozent (User.id als Plain-Feld) + Anzeigename.
  uploadedById   String
  uploadedByName String

  fileUrl      String
  filePathname String
  pageCount    Int

  createdAt DateTime @default(now())

  @@index([kurscode])
  @@index([trainingId])
  @@index([uploadedById])
}